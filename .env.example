# ==========================================
# AlfaCareers Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
APP_NAME=AlfaCareers
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
JWT_SECRET=change_this_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=alfacareers_user
POSTGRES_PASSWORD=alfacareers_password
POSTGRES_DB=alfacareers_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://alfacareers_user:alfacareers_password@localhost:5432/alfacareers_db

# ChromaDB Vector Store
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Local AI / LLM Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
EMBEDDING_MODEL=all-minilm

# Deep Web Hunter - Search APIs (Compliant Query Layer)
SERPAPI_KEY=your_serpapi_key_here
BING_SEARCH_API_KEY=your_bing_search_api_key_here

# WhatsApp Command Center (WAManager.io API Gateway)
WAMANAGER_API_KEY=your_wamanager_api_key_here
WAMANAGER_PHONE_NUMBER_ID=your_wamanager_phone_id_here
WAMANAGER_BASE_URL=https://api.wamanager.io/v1

# SMTP / Email Configuration (For Direct HR Outreach)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=careers@alfacareers.com
